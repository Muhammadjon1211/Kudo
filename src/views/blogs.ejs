<%- include("includes/header") %>

<section class="panel">
    <h1>Blog posts</h1>

    <form class="filters" action="/admin/blog/all" method="GET">
        <select name="blogStatus">
            <option value="">Active posts</option>
            <% ["PUBLISHED","DRAFT","DELETE"].forEach(function (s) { %>
            <option value="<%= s %>" <%= inquiry.blogStatus === s ? "selected" : "" %>>
                <%= s %>
            </option>
            <% }); %>
        </select>
        <input
            type="text"
            name="search"
            placeholder="Search by title"
            value="<%= inquiry.search || '' %>"
        />
        <button type="submit" class="btn btn-small">Search</button>
        <a
            class="icon-btn"
            href="/admin/blog/all"
            title="Clear search"
            aria-label="Clear search"
        >
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="m15 9-6 6" />
                <path d="m9 9 6 6" />
            </svg>
        </a>
    </form>

    <details class="creator">
        <summary>Write a post</summary>
        <form
            action="/admin/blog/create"
            method="POST"
            enctype="multipart/form-data"
            class="form"
        >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label>
                Title <input type="text" name="blogTitle" required />
            </label>
            <label>
                Text
                <textarea name="blogContent" rows="8" required></textarea>
            </label>
            <label>
                Image
                <input type="file" name="blogImage" accept="image/*" />
            </label>
            <label>
                Status
                <select name="blogStatus">
                    <option value="PUBLISHED">PUBLISHED</option>
                    <option value="DRAFT">DRAFT</option>
                </select>
            </label>
            <button type="submit" class="btn">Publish</button>
        </form>
    </details>

    <table class="table table-blogs">
        <thead>
            <tr>
                <th>Image</th>
                <th>Title</th>
                <th>Status</th>
                <th class="col-center">Views</th>
                <th class="col-center">Likes</th>
                <th>Created</th>
                <th class="th-actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (!blogs || blogs.length === 0) { %>
            <tr>
                <td colspan="7" class="empty">No blog posts found.</td>
            </tr>
            <% } %>
            <% (blogs || []).forEach(function (blog) { %>
            <tr>
                <td>
                    <% if (blog.blogImage) { %>
                    <img class="thumb" src="/<%= blog.blogImage %>" alt="<%= blog.blogTitle %>" />
                    <% } else { %>
                    <span class="muted">—</span>
                    <% } %>
                </td>
                <td>
                    <strong><%= blog.blogTitle %></strong>
                    <p class="excerpt"><%= blog.blogContent.slice(0, 120) %></p>
                </td>
                <td>
                    <span class="tag tag-<%= blog.blogStatus.toLowerCase() %>">
                        <%= blog.blogStatus %>
                    </span>
                </td>
                <td class="col-center"><%= blog.blogViews || 0 %></td>
                <td class="col-center">
                    <%
                       /* posts written before the counter existed have no
                          blogLikes field at all */
                    %>
                    <span class="likes">
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1L12 21l7.7-7.6 1.1-1a5.5 5.5 0 0 0 0-7.8Z" />
                        </svg>
                        <%= blog.blogLikes || 0 %>
                    </span>
                </td>
                <td><%= new Date(blog.createdAt).toLocaleDateString() %></td>
                <td class="actions">
                    <div class="action-row">
                    <a
                        class="icon-btn"
                        href="/admin/blog/edit/<%= blog._id %>"
                        title="Edit post"
                        aria-label="Edit <%= blog.blogTitle %>"
                    >
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 20h9" />
                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" />
                        </svg>
                    </a>
                    <% if (blog.blogStatus === "DELETE") { %>
                    <form
                        action="/admin/blog/edit/<%= blog._id %>"
                        method="POST"
                        enctype="multipart/form-data"
                        class="row-form"
                    >
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <input type="hidden" name="blogStatus" value="DRAFT" />
                        <button
                            type="submit"
                            class="icon-btn"
                            title="Restore post"
                            aria-label="Restore post"
                        >
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
                                <path d="M3 3v5h5" />
                            </svg>
                        </button>
                    </form>
                    <% } else { %>
                    <form
                        action="/admin/blog/delete/<%= blog._id %>"
                        method="POST"
                        class="row-form"
                        onsubmit="return confirm('Set this post to DELETE? The record stays in the database.')"
                    >
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button
                            type="submit"
                            class="icon-btn icon-danger"
                            title="Remove post"
                            aria-label="Remove post"
                        >
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 6h18" />
                                <path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2" />
                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                <path d="M10 11v6" />
                                <path d="M14 11v6" />
                            </svg>
                        </button>
                    </form>
                    <% } %>
                    </div>
                </td>
            </tr>
            <% }); %>
        </tbody>
    </table>

    <%- include("includes/pagination", { base: "/admin/blog/all" }) %>
</section>

<%- include("includes/footer") %>
