<%- include("includes/header") %>

<section class="panel">
    <h1>Products</h1>

    <form class="filters" action="/admin/product/all" method="GET">
        <select name="productStatus">
            <option value="">Active products</option>
            <% ["PROCESS","PAUSE","DELETE"].forEach(function (s) { %>
            <option value="<%= s %>" <%= inquiry.productStatus === s ? "selected" : "" %>>
                <%= s %>
            </option>
            <% }); %>
        </select>
        <input
            type="text"
            name="search"
            placeholder="Search by name"
            value="<%= inquiry.search || '' %>"
        />
        <button type="submit" class="btn btn-small">Search</button>
        <a
            class="icon-btn"
            href="/admin/product/all"
            title="Clear search"
            aria-label="Clear search"
        >
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="m15 9-6 6" />
                <path d="m9 9 6 6" />
            </svg>
        </a>
    </form>

    <details class="creator">
        <summary>Add a product</summary>
        <form
            action="/admin/product/create"
            method="POST"
            enctype="multipart/form-data"
            class="form form-inline"
        >
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label>
                Name <input type="text" name="productName" required />
            </label>
            <label>
                Price
                <input type="number" name="productPrice" min="0" step="0.01" required />
            </label>
            <label>
                Status
                <select name="productStatus">
                    <option value="PROCESS">PROCESS (on sale)</option>
                    <option value="PAUSE">PAUSE (hidden)</option>
                </select>
            </label>

            <fieldset class="sizes wide">
                <legend>Sizes in stock</legend>
                <p class="muted">
                    Tick every size this item is sold in and set how many are in
                    stock. Gear without sizing uses ONE_SIZE.
                </p>
                <div class="size-grid">
                    <% sizes.forEach(function (size) { %>
                    <label class="size-cell">
                        <span class="size-check">
                            <input type="checkbox" name="productSizes" value="<%= size %>" />
                            <%= size %>
                        </span>
                        <input
                            type="number"
                            name="sizeCount_<%= size %>"
                            min="0"
                            value="0"
                            class="tiny"
                        />
                    </label>
                    <% }); %>
                </div>
            </fieldset>

            <label class="wide">
                Description
                <textarea name="productDesc" rows="2"></textarea>
            </label>
            <label class="wide">
                Images (up to 5)
                <input type="file" name="productImages" accept="image/*" multiple />
            </label>
            <button type="submit" class="btn btn-small">Create product</button>
        </form>
    </details>

    <table class="table table-products">
        <thead>
            <tr>
                <th>Images</th>
                <th>Name</th>
                <th class="col-center">Sizes</th>
                <th class="col-center">Stock</th>
                <th>Price</th>
                <th>Status</th>
                <th class="th-actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (!products || products.length === 0) { %>
            <tr>
                <td colspan="7" class="empty">No products found.</td>
            </tr>
            <% } %>
            <% (products || []).forEach(function (product) {
                 const stocked = (product.productSizes || []);
                 const images = (product.productImages || []); %>
            <tr>
                <td>
                    <% if (!images.length) { %>
                    <span class="muted">—</span>
                    <% } %>
                    <div class="gallery">
                        <% images.forEach(function (image) { %>
                        <img class="thumb" src="/<%= image %>" alt="<%= product.productName %>" />
                        <% }); %>
                    </div>
                </td>
                <td><%= product.productName %></td>
                <td class="col-center">
                    <% if (!stocked.length) { %>
                    <span class="muted">—</span>
                    <% } %>
                    <div class="stock-list">
                        <% stocked.forEach(function (entry) { %>
                        <span class="stock-size"><%= entry.sizeName %></span>
                        <% }); %>
                    </div>
                </td>
                <td class="col-center">
                    <% if (!stocked.length) { %>
                    <span class="muted">—</span>
                    <% } %>
                    <div class="stock-list">
                        <% stocked.forEach(function (entry) { %>
                        <span class="stock-count <%= entry.sizeLeftCount > 0 ? '' : 'stock-empty' %>">
                            <%= entry.sizeLeftCount %>
                        </span>
                        <% }); %>
                    </div>
                </td>
                <td><%= product.productPrice %></td>
                <td>
                    <span class="tag tag-<%= product.productStatus.toLowerCase() %>">
                        <%= product.productStatus %>
                    </span>
                </td>
                <td class="actions">
                    <div class="action-row">
                    <button
                        type="button"
                        class="icon-btn"
                        data-open-modal="product-<%= product._id %>"
                        title="Edit product"
                        aria-label="Edit <%= product.productName %>"
                    >
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 20h9" />
                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" />
                        </svg>
                    </button>

                    <dialog
                        class="modal modal-wide"
                        id="product-<%= product._id %>"
                        aria-labelledby="product-title-<%= product._id %>"
                    >
                        <div class="modal-head">
                            <div>
                                <h2 class="modal-title" id="product-title-<%= product._id %>">
                                    Edit product
                                </h2>
                                <p class="modal-subject">
                                    <strong><%= product.productName %></strong>
                                </p>
                            </div>
                            <button
                                type="button"
                                class="icon-btn"
                                data-close-modal
                                title="Close"
                                aria-label="Close"
                            >
                                &times;
                            </button>
                        </div>

                        <form
                            action="/admin/product/edit/<%= product._id %>"
                            method="POST"
                            enctype="multipart/form-data"
                            class="form"
                        >
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <label>
                                Name
                                <input
                                    type="text"
                                    name="productName"
                                    value="<%= product.productName %>"
                                />
                            </label>
                            <label>
                                Price
                                <input
                                    type="number"
                                    name="productPrice"
                                    min="0"
                                    step="0.01"
                                    value="<%= product.productPrice %>"
                                />
                            </label>
                            <label>
                                Description
                                <textarea name="productDesc" rows="2"><%= product.productDesc || '' %></textarea>
                            </label>
                            <label>
                                Status
                                <select name="productStatus">
                                    <% ["PROCESS","PAUSE","DELETE"].forEach(function (s) { %>
                                    <option value="<%= s %>" <%= product.productStatus === s ? "selected" : "" %>>
                                        <%= s %>
                                    </option>
                                    <% }); %>
                                </select>
                            </label>
                            <fieldset class="sizes">
                                <legend>Sizes in stock</legend>
                                <div class="size-grid">
                                    <% sizes.forEach(function (size) {
                                         const entry = stocked.find(function (e) {
                                             return e.sizeName === size;
                                         }); %>
                                    <label class="size-cell">
                                        <span class="size-check">
                                            <input
                                                type="checkbox"
                                                name="productSizes"
                                                value="<%= size %>"
                                                <%= entry ? "checked" : "" %>
                                            />
                                            <%= size %>
                                        </span>
                                        <input
                                            type="number"
                                            name="sizeCount_<%= size %>"
                                            min="0"
                                            value="<%= entry ? entry.sizeLeftCount : 0 %>"
                                            class="tiny"
                                        />
                                    </label>
                                    <% }); %>
                                </div>
                            </fieldset>

                            <fieldset class="field-box">
                                <legend>Current images</legend>
                                <% if (!images.length) { %>
                                <p class="muted">No images uploaded yet.</p>
                                <% } %>
                                <div class="gallery">
                                    <% images.forEach(function (image) { %>
                                    <div class="gallery-item">
                                        <img class="thumb" src="/<%= image %>" alt="<%= product.productName %>" />
                                        <%
                                           /* posts to the image route instead of the
                                              edit route, as urlencoded because that
                                              route has no multipart uploader */
                                        %>
                                        <button
                                            type="submit"
                                            class="image-remove"
                                            formaction="/admin/product/image/remove/<%= product._id %>"
                                            formenctype="application/x-www-form-urlencoded"
                                            name="image"
                                            value="<%= image %>"
                                            title="Delete this image"
                                            aria-label="Delete this image"
                                            onclick="return confirm('Delete this image? Other unsaved edits in this popup are lost.')"
                                        >
                                            &times;
                                        </button>
                                    </div>
                                    <% }); %>
                                </div>
                            </fieldset>

                            <label>
                                Add images (kept alongside the current ones)
                                <input
                                    type="file"
                                    name="productImages"
                                    accept="image/*"
                                    multiple
                                />
                            </label>

                            <div class="modal-foot">
                                <button
                                    type="button"
                                    class="btn btn-small btn-ghost"
                                    data-close-modal
                                >
                                    Cancel
                                </button>
                                <button type="submit" class="btn btn-small">
                                    Save product
                                </button>
                            </div>
                        </form>
                    </dialog>
                    <% if (product.productStatus === "DELETE") { %>
                    <form
                        action="/admin/product/edit/<%= product._id %>"
                        method="POST"
                        enctype="multipart/form-data"
                        class="row-form"
                    >
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <input type="hidden" name="productStatus" value="PAUSE" />
                        <button type="submit" class="icon-btn" title="Restore product" aria-label="Restore product">
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
                                <path d="M3 3v5h5" />
                            </svg>
                        </button>
                    </form>
                    <% } else { %>
                    <form
                        action="/admin/product/delete/<%= product._id %>"
                        method="POST"
                        class="row-form"
                        onsubmit="return confirm('Set this product to DELETE? The record stays in the database.')"
                    >
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="icon-btn icon-danger" title="Remove product" aria-label="Remove product">
                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 6h18" />
                                <path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2" />
                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                <path d="M10 11v6" />
                                <path d="M14 11v6" />
                            </svg>
                        </button>
                    </form>
                    <% } %>
                    </div>
                </td>
            </tr>
            <% }); %>
        </tbody>
    </table>

    <%- include("includes/pagination", { base: "/admin/product/all" }) %>
</section>

<%- include("includes/footer") %>
