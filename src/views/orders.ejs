<%- include("includes/header") %>

<section class="panel">
    <h1>Orders</h1>

    <form class="filters" action="/admin/order/all" method="GET">
        <select name="orderStatus">
            <option value="">All statuses</option>
            <% ["PAUSE","PROCESS","FINISH","DELETE"].forEach(function (s) { %>
            <option value="<%= s %>" <%= inquiry.orderStatus === s ? "selected" : "" %>>
                <%= s %>
            </option>
            <% }); %>
        </select>
        <button type="submit" class="btn btn-small">Search</button>
        <a
            class="icon-btn"
            href="/admin/order/all"
            title="Clear filters"
            aria-label="Clear filters"
        >
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="m15 9-6 6" />
                <path d="m9 9 6 6" />
            </svg>
        </a>
    </form>

    <table class="table table-orders">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Items</th>
                <th>Delivery</th>
                <th class="col-center">Total</th>
                <th class="col-center">Status</th>
                <th>Placed</th>
                <th class="th-actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            <% if (!orders || orders.length === 0) { %>
            <tr>
                <td colspan="7" class="empty">No orders found.</td>
            </tr>
            <% } %>
            <% (orders || []).forEach(function (order) {
                 const buyer = (order.memberData || [])[0]; %>
            <tr>
                <td>
                    <% if (buyer) { %>
                    <strong><%= buyer.memberNick %></strong>
                    <div class="customer">
                        <% if (buyer.memberFullName) { %>
                        <div><%= buyer.memberFullName %></div>
                        <% } %>
                        <div><a href="tel:<%= buyer.memberPhone %>"><%= buyer.memberPhone %></a></div>
                        <% if (buyer.memberAddress) { %>
                        <div class="muted"><%= buyer.memberAddress %></div>
                        <% } else { %>
                        <div class="muted">no address on file</div>
                        <% } %>
                    </div>
                    <% } else { %>
                    <span class="muted">deleted member</span>
                    <% } %>
                    <div class="mono"><%= order._id %></div>
                </td>
                <td>
                    <ul class="items">
                        <% (order.orderItems || []).forEach(function (item) {
                             const product = (order.productData || []).find(function (p) {
                                 return String(p._id) === String(item.productId);
                             }); %>
                        <li>
                            <%= product ? product.productName : "removed product" %>
                            <span class="tag"><%= item.itemSize %></span>
                            &times; <%= item.itemQuantity %>
                            <span class="muted">(<%= item.itemPrice %>)</span>
                        </li>
                        <% }); %>
                    </ul>
                </td>
                <td><%= order.orderDelivery %></td>
                <td class="col-center"><strong><%= order.orderTotal %></strong></td>
                <td class="col-center">
                    <span class="tag tag-<%= order.orderStatus.toLowerCase() %>">
                        <%= order.orderStatus %>
                    </span>
                </td>
                <td><%= new Date(order.createdAt).toLocaleString() %></td>
                <td class="actions">
                    <div class="action-row">
                        <form
                            action="/admin/order/edit/<%= order._id %>"
                            method="POST"
                            class="row-form"
                        >
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                            <select name="orderStatus" class="status-select">
                                <% ["PAUSE","PROCESS","FINISH","DELETE"].forEach(function (s) { %>
                                <option value="<%= s %>" <%= order.orderStatus === s ? "selected" : "" %>>
                                    <%= s %>
                                </option>
                                <% }); %>
                            </select>
                            <button
                                type="submit"
                                class="icon-btn"
                                title="Save status"
                                aria-label="Save status"
                            >
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M20 6 9 17l-5-5" />
                                </svg>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
            <% }); %>
        </tbody>
    </table>

    <%- include("includes/pagination", { base: "/admin/order/all" }) %>
</section>

<%- include("includes/footer") %>
