<%- include("includes/header") %>

<% const signedIn = typeof member !== "undefined" && member; %>

<% if (signedIn) {
     const now = new Date();
     const hour = now.getHours();
     const partOfDay =
         hour < 12 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
     const name = member.memberFullName || member.memberNick; %>
<section class="panel">
    <div class="greeting">
        <h1>Welcome back, <%= name %></h1>
        <p class="greeting-line">
            <%= partOfDay %>
            <span class="dot">&middot;</span>
            signed in as <strong><%= member.memberNick %></strong>
            <span class="tag"><%= member.memberType %></span>
            <span class="dot">&middot;</span>
            <%= now.toLocaleDateString(undefined, {
                    weekday: "long",
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                }) %>
        </p>
    </div>

    <% if (stats && stats.pending) { %>
    <p class="notice">
        <strong><%= stats.pending %></strong>
        order<%= stats.pending === 1 ? "" : "s" %> awaiting processing.
        <a href="/admin/order/all?orderStatus=PAUSE">Open the queue</a>
    </p>
    <% } %>

    <div class="tiles">
        <a class="tile" href="/admin/user/all">
            <h2>Users</h2>
            <% if (stats) { %><span class="tile-count"><%= stats.members %></span><% } %>
            <p>Students, coaches and admins</p>
        </a>
        <a class="tile" href="/admin/product/all">
            <h2>Products</h2>
            <% if (stats) { %><span class="tile-count"><%= stats.products %></span><% } %>
            <p>Shop catalogue &mdash; kimono, belts, helmets</p>
        </a>
        <a class="tile" href="/admin/blog/all">
            <h2>Blog posts</h2>
            <% if (stats) { %><span class="tile-count"><%= stats.blogs %></span><% } %>
            <p>News published on the website</p>
        </a>
        <a class="tile" href="/admin/contact">
            <h2>Contact</h2>
            <p>Phone, address and socials</p>
        </a>
        <a class="tile" href="/admin/order/all">
            <h2>Orders</h2>
            <% if (stats) { %>
            <span class="tile-count"><%= stats.orders %></span>
            <% } %>
            <p>
                <% if (stats && stats.pending) { %>
                <strong><%= stats.pending %> awaiting processing</strong>
                <% } else { %>
                Shop orders and their status
                <% } %>
            </p>
        </a>
        <a class="tile" href="/admin/profile">
            <h2>Profile</h2>
            <p>Your details and password</p>
        </a>
    </div>
</section>
<% } else { %>
<section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-inner">
        <p class="hero-eyebrow">Kudo &middot; Admin</p>
        <h1 class="hero-title">Welcome to the<br />Kudo Admin Panel</h1>
        <p class="hero-lead">
            One place to run the school &mdash; students and their belt ranks,
            the medals they win, the shop catalogue, orders and the news feed.
        </p>
        <div class="hero-cta">
            <a class="btn btn-lg" href="/admin/login">Sign in</a>
            <span class="hero-note">Staff access only</span>
        </div>
    </div>
</section>

<div class="hero-features">
    <article class="feature">
        <span class="feature-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M22 21v-2a4 4 0 0 0-3-3.9" />
                <path d="M16 3.1a4 4 0 0 1 0 7.8" />
            </svg>
        </span>
        <h2>Students &amp; grading</h2>
        <p>Belt ranks from white to black, and the medals each student has won.</p>
    </article>

    <article class="feature">
        <span class="feature-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
                <path d="M3 6h18" />
                <path d="M16 10a4 4 0 0 1-8 0" />
            </svg>
        </span>
        <h2>Shop catalogue</h2>
        <p>Kimono, belts and helmets, with the stock left in every size.</p>
    </article>

    <article class="feature">
        <span class="feature-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 3h6a1 1 0 0 1 1 1v2H8V4a1 1 0 0 1 1-1Z" />
                <path d="M16 5h2a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2" />
                <path d="m9 13 2 2 4-4" />
            </svg>
        </span>
        <h2>Orders</h2>
        <p>Follow every order from placed through to finished.</p>
    </article>

    <article class="feature">
        <span class="feature-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h13a1 1 0 0 1 1 1v14a2 2 0 0 0 2 2H5a2 2 0 0 1-2-2V5a1 1 0 0 1 1-1Z" />
                <path d="M18 8h2a1 1 0 0 1 1 1v10a2 2 0 0 1-2 2" />
                <path d="M7 8h7" />
                <path d="M7 12h7" />
                <path d="M7 16h4" />
            </svg>
        </span>
        <h2>News</h2>
        <p>Write the posts that appear on the public website.</p>
    </article>
</div>
<% } %>

<%- include("includes/footer") %>
